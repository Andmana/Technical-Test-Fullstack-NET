<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>Registration</title>

    <!-- == Theme Plugin == -->
    <!-- accordion -->
    <link href="~/digify/css/bootstrap.min.css" rel="stylesheet">

    <!-- Theme style General -->
    <link rel="stylesheet" href="~/digify/css/style.css">

    <!-- Theme style Page -->
    <!-- summernote -->
    <link href="https://cdn.jsdelivr.net/npm/summernote@0.8.18/dist/summernote-bs4.min.css" rel="stylesheet">


    @* Jquery *@
    <!-- Jquery -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <!-- Jquery Validate-->
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>

    <style>
        *, *::before, *::after {
            box-sizing: border-box;
        }

        .tab {
            position: relative;
            color: #e5f3ff;
            border: 1px solid;
            border-radius: 0.5rem;
            margin: -9px;
            padding-left: 20px;
            padding-right: 20px;
        }

        .tab input {
            position: absolute;
            opacity: 0;
            z-index: -1;
        }

        .tab__content {
            max-height: 0;
            overflow: hidden;
            transition: all 0.35s;
        }

        .tab input:checked ~ .tab__content {
            max-height: 55rem;
            background: #175e9c;
            color: white;
        }

        .accordion {
            color: #006cb8;
            font-size: 15px;
            overflow: hidden;
        }

        .tab__label,
        .tab__close {
            display: flex;
            color: white;
            background: #227093;
            cursor: pointer;
        }

        .tab__label {
            justify-content: space-between;
            padding: 13px;
            background: white;
            color: #66a7d4;
        }

        .tab__label::after {
            content: "\276F";
            width: 1em;
            height: 1em;
            text-align: center;
            transform: rotate(90deg);
            transition: all 0.35s;
        }

        .tab input:checked + .tab__label::after {
            transform: rotate(270deg);
        }

        .tab__content p {
            margin: 0;
            padding: 1rem;
        }

        .tab__close {
            justify-content: flex-end;
            padding: 0.5rem 1rem;
            font-size: 0.75rem;
        }

        .tab input:not(:checked) + .tab__label:hover::after {
            animation: bounce 0.5s infinite;
        }

        @@keyframes bounce {
            25% {
                transform: rotate(90deg) translate(0.25rem);
            }

            75% {
                transform: rotate(90deg) translate(-0.25rem);
            }
        }
    </style>
</head>

<body class="hold-transition layout-fixed">
    <div class="content content-mt-min4" style="padding-top:90px; background-color: #e7eff6;">
        <div class="container-fluid">
            <div class="row">
                <div class="col-lg-7">
                    <div style="background: transparent; !important; border : 0 !important;">
                        <div class="card-body py-3">
                            <div class="px-3 mb-4">
                                <h2 class="title-hallo medium-text" style="line-height: 1.6rem;">
                                    JASA PERBANTUAN PENGAWASAN UNTUK PEKERJAAN PENANGGULANGAN LONGSOR LAWE
                                </h2>
                                <img src="~/digify/img/linesna.png">
                                <br><br>
                                <div class="row">
                                    <div class="col-md-7">
                                        <div>
                                            <h6><b>Registration Deadline</b></h6>
                                            <span style="font-size: 13px;"><b>Start</b></span><br>
                                            <p style="font-size: 17px;">
                                                Monday, 25th September 2023<br>
                                                08.30 WIB (UTC+7})<br>
                                                <span style="font-size: 13px;"><b>End</b></span><br>
                                                Thursday, 28th September 2023<br>
                                                16.30 WIB (UTC+7})
                                            </p>
                                            <button class="btn btn-danger">3 Days : 20 Hours : 58 Minutes Remaining</button>
                                        </div>
                                    </div>
                                    <div class="col-md-5">
                                        <div class="contact-add-item">
                                            <div>
                                                <p class="mb-0"><img src="~/digify/img/kotakkotak.jpg"></p>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <h6 style="padding-left:20px"><b>Registration Guidance</b></h6>
                            <div class="doc-attachement-item" style="margin: 20px;">
                                <img class="icon-file-xs" src="~/digify/img/icon-PDF-file-solid.svg">
                                <div class="file-meta">
                                    <span class="text-ellipsis bold-text">File-Guide-23092024.pdf</span>
                                    <span>1.290 Kb</span>
                                </div>
                                <div class="doc-attachement-action">
                                    <button class="btn btn-icon btn-sm btn-outline-primary" data-toggle="modal" data-target="#Modal-PDF">
                                        <i class="ppcs-icon icon-eye-open"></i>
                                    </button>
                                    <button class="btn btn-icon btn-sm btn-outline-primary">
                                        <i class="ppcs-icon icon-download"></i>
                                    </button>
                                </div>
                            </div>

                            <h6 style="padding-left:20px;"><b>Frequently Asked Question (FAQ)</b></h6>
                            <div class="p-3 px-2">
                                <section class="accordion">
                                    <div class="tab">
                                        <input type="checkbox" name="accordion-1" id="cb1">
                                        <label for="cb1" class="tab__label"><b>How to Register the PQ?</b></label>
                                        <div class="tab__content">
                                            <p>
                                                Individual Company must filling-out the registration form starting from Monday, 04 September 2023 08.00am Jakarta Local Time up to Thursday, 07 September 2023 04.00pm Jakarta Local Time. Beyond this period, the link will be automatically closed.<br>
                                                Following fields shall be input by using alphabetic characters and numeral only (please avoid any symbols): Company Name, NPWP/Tax Identification Number, Director Name, PIC Name and Phone Number
                                            </p>
                                        </div>
                                    </div>

                                    <div class="tab">
                                        <input type="checkbox" name="accordion-1" id="cb2">
                                        <label for="cb2" class="tab__label"><b>What documents are Required for PQ Registration?</b></label>
                                        <div class="tab__content">
                                            <p>
                                                Company must upload following documents:<br>
                                                1. Nomor Pokok Wajib Pajak (NPWP) / Taxpayer Identification Number, and<br>
                                                2. Power of Attorney from Chief Executive Officer or equivalent position in the Company, to authorize the Company's PIC.
                                            </p>
                                        </div>
                                    </div>

                                    <div class="tab">
                                        <input type="checkbox" name="accordion-1" id="cb3">
                                        <label for="cb3" class="tab__label"><b>What if I don't submit the required documents?</b></label>
                                        <div class="tab__content">
                                            <p>You cannot proceed with your application if you do not submit the required documents.</p>
                                        </div>
                                    </div>

                                    <div class="tab">
                                        <input type="checkbox" name="accordion-1" id="cb4">
                                        <label for="cb4" class="tab__label"><b>What if I have trouble??</b></label>
                                        <div class="tab__content">
                                            <p>
                                                If Company experiences any trouble / difficulties during Prequalification registration process, please do not hesitate to contact us at sekrepc.dht4@pertamina.com.
                                            </p>
                                        </div>
                                    </div>
                                </section>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="col-lg-5">
                    <div class="card p-4">
                         <form  asp-action="CompanyRegistration"  method="post" id="form-input" enctype="multipart/form-data">
                             <div class="row">
                                 <div class="col-12 mb-3">
                                     <span class="sign-required size-textsm">* Required</span>
                                 </div>
                                 <div class="p-3 py-3">

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">Company Name<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="text" class="form-control" name="Name" placeholder="Enter Company Name" required>
                                         </div>
                                     </div>

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">NPWP<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="text" class="form-control" name="Npwp" placeholder="Enter NPWP" required>
                                         </div>
                                     </div>

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">Director Name<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="text" class="form-control" name="DirectorName" placeholder="Enter Director Name" required>
                                         </div>
                                     </div>

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">PIC Name<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="text" class="form-control" name="PicName" placeholder="Enter PIC Name" required>
                                         </div>
                                     </div>

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">Email<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="email" class="form-control" name="Email" placeholder="Enter Email" required>
                                         </div>
                                     </div>

                                     <div class="form-one-col-row form-col-column">
                                         <div class="label-form">Phone Number<span class="sign-required">*</span></div>
                                         <div class="field-form">
                                             <input type="tel" class="form-control" name="PhoneNumber" placeholder="Enter Phone Number" required>
                                         </div>
                                     </div>

                                     <h6 style="padding-left:5px;"><b>Document Upload</b></h6>

                                     <div class="row-input-file">
                                         <div class="label">NPWP Document <span class="sign-required">*</span></div>
                                         <div class="input-group custominputfile d-flex align-items-center gap-2">
                                             <div class="custom-file">
                                                <input type="file" class="custom-file-input" name="NpwpDocument" id="NpwpDocument" accept=".pdf" required>
                                                <label class="custom-file-label" for="NpwpDocument">Search file</label>
                                             </div>
                                             <div class="input-group-append">
                                                 <span class="input-group-text textapps-xs">
                                                     <img class="img-icon" src="~/digify/img/icon-upload-file-solid.svg" > Upload
                                                 </span>
                                             </div>
                                         </div>
                                     </div>

                                     <div class="row-input-file">
                                         <div class="label">Power of Attorney Document <span class="sign-required">*</span></div>
                                         <div class="input-group custominputfile d-flex align-items-center gap-2">
                                             <div class="custom-file">
                                                <input type="file" class="custom-file-input" name="PowerOfAttoreyDocument" id="PowerOfAttoreyDocument" accept=".pdf" required>
                                                <label class="custom-file-label" for="PowerOfAttoreyDocument">Search file</label>
                                             </div>
                                             <div class="input-group-append">
                                                 <span class="input-group-text textapps-xs">
                                                     <img class="img-icon" src="~/digify/img/icon-upload-file-solid.svg"> Upload
                                                 </span>
                                             </div>
                                         </div>
                                     </div>

                                     <div class="custom-control custom-checkbox d-flex align-items-center gap-2">
                                         <input class="custom-control-input" type="checkbox" name="InvitationAccess" id="InvitationAccess" value="true">
                                         <label class="custom-control-label" for="InvitationAccess">
                                             Allow access to invitation after closing date
                                         </label>
                                     </div>

                                     <div class="d-flex align-items-center gap-xl flex-wrap header-content-action mt-4">
                                         <button type="reset" class="btn btn-sm btn-outline-primary">Clear Form</button>
                                         <button type="submit" class="btn btn-sm btn-primary">Submit</button>
                                     </div>
                                 </div>
                             </div>
                         </form>

                    </div>
                </div>

            </div><!-- /.row -->
        </div><!-- /.container-fluid -->
    </div><!-- /.content -->
</body>


<script>
    jQuery.validator.addMethod("typeFile", function (value, element, param) {
        return value.toLowerCase().endsWith("." + param);
    });

    jQuery.validator.addMethod("sizeFile", function (val, element) {
        var size = element.files[0].size;
        return size <= (1 * 1024 * 1024); // 1MB
    });

    $("#form-input").validate({
        errorClass: "text-danger",
        rules: {
            Name: { required: true, minlength: 3 },
            Npwp: { required: true, minlength: 15 },
            DirectorName: { required: true, minlength: 3 },
            PicName: { required: true, minlength: 3 },
            Email: { required: true, email: true },
            PhoneNumber: { required: true },
            NpwpDocument: {
                required: true,
                typeFile: "pdf",
                sizeFile: true,
            },
            PowerOfAttoreyDocument: {
                required: true,
                typeFile: "pdf",
                sizeFile: true
            }
        },
        messages: {
            Name: {
                required: "Please fill Company Name",
                minlength: "Minimal character is 3"
            },
            Npwp: {
                required: "Please fill NPWP",
                minlength: "Minimal character is 15"
            },
            DirectorName: {
                required: "Please fill Director Name",
                minlength: "Minimal character is 3"
            },
            PicName: {
                required: "Please fill PIC Name",
                minlength: "Minimal character is 3"
            },
            Email: {
                required: "Please enter the email",
                email: "Please enter a valid email (name@mail.com)",
            },
            PhoneNumber: {
                required: "Please enter the phone number",
            },
            NpwpDocument: {
                required: "Please upload file",
                typeFile: "Please upload format is pdf",
                sizeFile: "Please upload file size ≤ 1MB",
            },
            PowerOfAttoreyDocument: {
                required: "Please upload file",
                typeFile: "Please upload format is pdf",
                sizeFile: "Please upload file size ≤ 1MB",
            }
        },
        submitHandler: function (form) {
            var formData = new FormData(form);
            $.ajax({
                url: "/Home/CompanyRegistration",
                type: 'POST',
                data: formData,
                processData: false,
                contentType: false,
                success: function (response) {
                    alert(response.message);
                },
                error: function (xhr, status, error) {
                    alert('There was an error submitting the form.');
                    console.log("Status:", status);
                    console.log("Error:", error);

                    try {
                        const responseJson = JSON.parse(xhr.responseText);
                        console.log("Response JSON:", responseJson);

                        if (responseJson.errors) {
                            for (const key in responseJson.errors) {
                                if (responseJson.errors.hasOwnProperty(key)) {
                                    console.log(`${key}: ${responseJson.errors[key].join(', ')}`);
                                }
                            }
                        } else {
                            console.log("Message:", responseJson.message || xhr.responseText);
                        }
                    } catch (e) {
                        console.warn("Raw response:", xhr.responseText);
                    }
                }
            });
        }
    });
</script>

</html>
